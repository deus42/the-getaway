{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "typeRoots": ["../../the-getaway/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "playwright": ["../../the-getaway/node_modules/playwright"]
    }
  },
  "include": ["./**/*.ts"]
}
