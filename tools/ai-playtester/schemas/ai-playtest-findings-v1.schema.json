{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_playtest_findings_v1",
  "type": "object",
  "required": ["schema", "runId", "profile", "generatedAt", "summary", "scorecard", "findings", "trace"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "ai_playtest_findings_v1" },
    "runId": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "scorecard": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [{ "type": "number" }, { "type": "string" }]
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "action", "result"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer", "minimum": 0 },
          "action": { "type": "string" },
          "result": { "type": "string" },
          "screenshot": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "category",
        "title",
        "reproSteps",
        "expected",
        "observed",
        "evidence",
        "suspectedOwner",
        "confidence",
        "linearSuggestion"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "category": {
          "enum": [
            "progression",
            "stealth",
            "combat",
            "ui",
            "performance",
            "accessibility",
            "stability",
            "content",
            "tooling"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "reproSteps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expected": { "type": "string" },
        "observed": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suspectedOwner": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "dedupeKey": { "type": "string" },
        "findingType": { "enum": ["gameplay", "tooling", "agent-strategy"] },
        "mergedFrom": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blockingMilestone": { "type": "string" },
        "agentConfidenceNotes": { "type": "string" },
        "linearSuggestion": {
          "type": "object",
          "required": ["title", "description", "label", "priority"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "label": { "enum": ["Bug", "Improvement", "Feature"] },
            "priority": { "enum": ["Urgent", "High", "Medium", "Low", "No priority"] }
          }
        }
      }
    }
  }
}
