{
  "name": "the-getaway",
  "private": true,
  "version": "2026.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "node scripts/check-scene-architecture.mjs && tsx scripts/validate-level0-layout-contract.ts && tsx scripts/validate-level0-painterly-art.ts && eslint .",
    "art:level0:footprints": "tsx scripts/export-level0-building-footprints.ts",
    "art:level0:build": "yarn art:level0:footprints && uv run --with pillow python ../art/painterly/level0/scripts/build_runtime_assets.py --buildings-only",
    "preview": "vite preview",
    "playtest:agent": "tsx ../tools/ai-playtester/run.ts",
    "graphics:get155": "node scripts/generate-get155-preview-assets.mjs",
    "art:level0:validate": "tsx scripts/validate-level0-painterly-art.ts",
    "layout:level0:export": "tsx scripts/export-level0-layout-contract.ts",
    "layout:level0:validate": "tsx scripts/validate-level0-layout-contract.ts",
    "sprites:seed-placeholders": "tsx scripts/generate-character-sprite-placeholders.ts",
    "sprites:validate": "tsx scripts/validate-character-sprites.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "narrative:generate": "tsx scripts/generate-scene-from-story.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.1",
    "autoprefixer": "^10.4.21",
    "phaser": "^3.90.0",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "tailwindcss": "^4.0.17",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/postcss": "^4.0.17",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.59.1",
    "ts-jest": "^29.3.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
